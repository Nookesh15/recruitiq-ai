# ─────────────────────────────────────────────────────────────
# RecruitIQ AI — Environment Variables
# Copy this file to .env and fill in your values before running:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── SQL Server ────────────────────────────────────────────────
# SA password must meet SQL Server complexity requirements:
#   - Min 8 characters
#   - Uppercase + lowercase + digit + symbol
MSSQL_SA_PASSWORD=Str0ng!Pass2024

# ── LLM Integration (RIQAI-29) ───────────────────────────────
# LLM_PROVIDER: "openai" | "anthropic" | "none"  (default: "none" — regex fallback)
# Leave LLM_PROVIDER=none to use the built-in regex scoring (no API key needed)
LLM_PROVIDER=none
LLM_API_KEY=sk-your-openai-or-anthropic-key-here
# Optional: override default model (gpt-4o-mini for OpenAI, claude-haiku-4-5-20251001 for Anthropic)
# LLM_MODEL=gpt-4o-mini

# ── JWT Secret (Backend) ──────────────────────────────────────
# At least 32 characters; generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# ── Email Notifications (RIQAI-27) ───────────────────────────
# Leave Email__Host blank to disable email (emails are skipped silently)
# Works with any SMTP relay, including SendGrid (smtp.sendgrid.net:587)
Email__Host=smtp.sendgrid.net
Email__Port=587
Email__EnableSsl=true
Email__From=noreply@recruitiq.ai
Email__Username=apikey
Email__Password=SG.your-sendgrid-api-key-here

# ── Optional: override default ports ─────────────────────────
# FRONTEND_PORT=4200
# BACKEND_PORT=5000
# AI_ENGINE_PORT=8000
# DB_PORT=1433
