# ===========================
# RecruitIQ AI — .gitignore
# ===========================

# ---- Secrets & Environment ----
.env
.env.*
!.env.example
*.pem
*.key
secrets/
appsettings.Production.json
appsettings.Local.json

# ---- Angular / Node ----
frontend/node_modules/
frontend/dist/
frontend/.angular/cache/
frontend/.env
*.js.map

# ---- .NET / C# ----
backend/bin/
backend/obj/
backend/*.user
backend/.vs/
backend/**/*.suo
backend/**/*.user
backend/**/bin/
backend/**/obj/
*.nupkg
*.snupkg

# ---- Python / AI Engine ----
ai-engine/__pycache__/
ai-engine/.venv/
ai-engine/venv/
ai-engine/*.egg-info/
ai-engine/.pytest_cache/
ai-engine/.mypy_cache/
ai-engine/dist/
*.pyc
*.pyo
*.pyd

# ---- Docker ----
infrastructure/.env

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- IDEs ----
.vscode/settings.json
.idea/
*.swp
*.swo

# ---- Logs ----
logs/
*.log
npm-debug.log*

# ---- Test Coverage ----
coverage/
TestResults/
htmlcov/
.coverage
