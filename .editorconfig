root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,js,html,css,scss}]
indent_size = 2

[*.{cs,csproj}]
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 88

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
